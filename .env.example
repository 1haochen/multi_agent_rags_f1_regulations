# API keys
OPENAI_API_KEY=REPLACE
PINECONE_API_KEY=REPLACE

# Embedding model, select your own here. By default, we use BAAI/bge-based-en.
EMBEDDING_MODEL=BAAI/bge-based-en

# Shared Pinecone defaults for ingest/retrieval/QA
PINECONE_INDEX_NAME=regs-2026-bgebased
PINECONE_NAMESPACE=regulations-2026
# Optional: set only when host belongs to this same index
# PINECONE_HOST=
